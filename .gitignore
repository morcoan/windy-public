# Linker MAPs are reproducible build intermediates. Exact source identities are
# frozen in eval/grand/manifest.json.
/eval/grand/bin/**/*.map
/eval/grand/bin/**/*_ghidra_targets.txt

# Secrets / credentials — never commit
*_key.txt
*_secret*
*.pem
.env
.env.*
!.env.example

