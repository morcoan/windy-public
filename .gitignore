# Authored Grand fixtures: every PE has checked-in C source, build profile,
# and SHA-256 provenance in eval/grand/manifest.json.
!eval/grand/bin/**/*.exe
*.pdb
!gclsd/bench/sample.pdb
*.obj
*.o
*.lib
*.dll
*.exp
*.ilk
